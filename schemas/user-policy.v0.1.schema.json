{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wa-commons.example/schemas/user-policy.v0.1.schema.json",
  "title": "WA Commons User Policy v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "title",
    "description",
    "origin",
    "default_decision",
    "uncertainty",
    "exclusions",
    "preferences"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "profile_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9:_-]+$"
    },
    "profile_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "description": {"type": "string", "minLength": 1, "maxLength": 1200},
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "author", "official_status"],
      "properties": {
        "kind": {"enum": ["user", "community", "example"]},
        "author": {"type": "string", "minLength": 1, "maxLength": 160},
        "official_status": {"const": "not_official"},
        "forked_from": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["profile_id", "profile_version"],
          "properties": {
            "profile_id": {"type": "string", "minLength": 3, "maxLength": 128},
            "profile_version": {"type": "string", "minLength": 1, "maxLength": 32}
          }
        }
      }
    },
    "default_decision": {
      "const": "NONE",
      "description": "A non-match is not evidence of safety and therefore cannot default to PASS."
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknown", "disputed", "expired"],
      "properties": {
        "unknown": {"enum": ["WATCH", "NONE"]},
        "disputed": {"enum": ["WATCH", "NONE"]},
        "expired": {"enum": ["WATCH", "NONE"]}
      }
    },
    "exclusions": {
      "type": "array",
      "items": {"$ref": "#/$defs/exclusionRule"},
      "maxItems": 200
    },
    "preferences": {
      "type": "array",
      "items": {"$ref": "#/$defs/preferenceRule"},
      "maxItems": 200
    }
  },
  "$defs": {
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories"],
      "properties": {
        "categories": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 96},
          "minItems": 1,
          "uniqueItems": true
        },
        "predicates": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 160},
          "minItems": 1,
          "uniqueItems": true
        },
        "jurisdictions": {
          "type": "array",
          "items": {"type": "string", "minLength": 2, "maxLength": 16},
          "minItems": 1,
          "uniqueItems": true
        },
        "source_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 160},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "value"],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^(claim\\.value(?:\\.[A-Za-z0-9_]+)*|adjudication\\.confidence)$"
        },
        "operator": {"enum": ["eq", "neq", "gt", "gte", "lt", "lte", "in", "exists"]},
        "value": {}
      }
    },
    "exclusionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "description", "match", "decision"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "description": {"type": "string", "minLength": 1, "maxLength": 800},
        "match": {"$ref": "#/$defs/match"},
        "condition": {"$ref": "#/$defs/condition"},
        "min_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "decision": {"enum": ["EXCLUDE", "WATCH"]}
      }
    },
    "preferenceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "description", "match", "direction", "weight"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "description": {"type": "string", "minLength": 1, "maxLength": 800},
        "match": {"$ref": "#/$defs/match"},
        "condition": {"$ref": "#/$defs/condition"},
        "min_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "direction": {"enum": ["prefer", "avoid"]},
        "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    }
  }
}
